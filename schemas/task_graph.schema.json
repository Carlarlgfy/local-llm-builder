{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskGraph",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_name", "tasks"],
  "properties": {
    "project_name": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "goal", "dependencies", "files", "acceptance_checks"],
        "properties": {
          "id": {"type": "string", "pattern": "^task-[0-9]{2,}$"},
          "title": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "acceptance_checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "expected"],
              "properties": {
                "command": {"type": "string", "minLength": 1},
                "expected": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
